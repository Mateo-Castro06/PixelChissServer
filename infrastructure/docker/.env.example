POSTGRES_DB=pixelchiss
POSTGRES_USER=pixelchiss
POSTGRES_PASSWORD=change_me

EUREKA_URL=http://eureka-server:8761/eureka/

DB_HOST=postgres
DB_PORT=5432
DB_NAME=${POSTGRES_DB}
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}

# Auth Service
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# OAUTH_REDIRECT_URI=http://localhost:8081/login/oauth2/code/google

JWT_PRIVATE_KEY_PATH=/app/keys/private_key.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public_key.pem

# Game Service: Docker DNS names, not localhost.
MONGODB_URI=mongodb://mongodb:27017/pixelchiss
# Keep false when maintaining a catalog that must not be repopulated at startup.
GAME_SEED_ENABLED=true
REDIS_URL=redis://redis:6379/0
GAME_ALLOWED_ORIGINS=http://localhost:8080

# Generate a private value in the untracked .env, for example: openssl rand -hex 32
# At least 32 characters. Share only with the future Lobby integration.
GAME_LOBBY_TOKEN=

# Optional monitoring profile. Use random values; never commit real secrets.
# PIXELCHISS_METRICS_KEY must have at least 32 characters.
PIXELCHISS_METRICS_KEY=
GRAFANA_ADMIN_PASSWORD=

# Lobby consumes the Game stream from REDIS_URL (DB 0), not LOBBY_REDIS_URL (DB 1).
# GAME_EVENTS_STREAM=pixelchiss:game:integration

# Auto enables AOF for fresh data, but loads existing RDB until it is converted live.
REDIS_APPENDONLY=auto
